# ControlPoint-AI Environment Configuration Example
# Copy to .env and configure for local deployment

PROJECT_NAME="ControlPoint-AI"
ORGANIZATION="IndustrySphere AI"
TAGLINE="Control What Your AI Agents Can Do."
VERSION="1.0.0"

# Environment: "development", "testing", "demo", or "production"
ENVIRONMENT="development"

# Security & Secrets
# In production, provide a cryptographically secure random token (>= 32 chars)
SECRET_KEY="cp_dev_secret_key_for_local_testing_only_64chars_min_length_abcdef"
ADMIN_API_KEY="cp_live_admin_secret_key_2026"
ENABLE_DEMO_MODE="true"

# Database Configuration (SQLite for local demo; PostgreSQL for high-scale persistent deployment)
# Examples:
# DATABASE_URL="sqlite:///./controlpoint.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/controlpoint"
DATABASE_URL="sqlite:///./controlpoint.db"

# Rate Limiting Defaults
RATE_LIMIT_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Server Port
PORT=8000
